# Kane / Kāne Platform — environment example (public-safe)
# Copy values as needed. Do NOT commit real secrets or .env files.
#
# Suggested layout:
#   apps/web/.env.local     — Web (NEXT_PUBLIC_*)
#   API / Bridge process    — export OCTOPUS_* / LLM_* in shell or service env
#
# See PUBLIC_REPO_README.md § Environment configuration.

# --- Web (browser) — copy to apps/web/.env.local ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- API process ---
# URL the Local Bridge uses to call back into API (must be reachable from bridge host)
OCTOPUS_API_PUBLIC_URL=http://127.0.0.1:8000
# API → Bridge probe / dispatch
OCTOPUS_LOCAL_BRIDGE_URL=http://127.0.0.1:8010
# Optional shared secret for Bridge <-> API (header X-Octopus-Bridge-Key)
# OCTOPUS_BRIDGE_SHARED_SECRET=change-me
# Optional API token (header X-Api-Key or Authorization: Bearer). Unset = open on localhost dev.
# OCTOPUS_API_TOKEN=change-me
# CORS allowlist for Web (comma-separated). Default: http://127.0.0.1:3000,http://localhost:3000
# OCTOPUS_CORS_ORIGINS=http://127.0.0.1:3000
# Optional cwd jail for Bridge local_script adapter
# OCTOPUS_BRIDGE_WORKSPACE_ROOT=C:\path\to\safe\workspace
# Optional: override directory for *.json entity files (default: apps/api/data)
# OCTOPUS_API_DATA_DIR=C:\path\to\empty\dir

# --- Local Bridge process ---
# Same OCTOPUS_API_PUBLIC_URL as above when Bridge runs on the same machine
# OPENCLAW_WEBHOOK_URL=https://your-openclaw-ingest.example/hook

# --- LLM (API process; Kanaloa / OpenAI-compatible providers) ---
# Prefer process env over storing keys in runtime JSON profiles.
OCTOPUS_LLM_API_KEY=
LLM_API_KEY=
# unlimited / empty / 0 = do not send max_tokens (provider default applies)
LLM_MAX_TOKENS=unlimited
OCTOPUS_LLM_MAX_TOKENS=unlimited

# --- Persistence (optional PostgreSQL) ---
# Default: file-backed JSON store. Uncomment for Postgres (see docs/ARCHITECTURE.md).
# OCTOPUS_PERSISTENCE=file
# OCTOPUS_PERSISTENCE=postgres
# DATABASE_URL=postgresql+psycopg://octopus:octopus@127.0.0.1:5432/octopus
# OCTOPUS_DATABASE_URL=postgresql+psycopg://octopus:octopus@127.0.0.1:5432/octopus

# --- Kanaloa permission profile (API) ---
# KANE_PERMISSION_PROFILE=owner
# OCTOPUS_ENV=development
# CLAUDE_CODE_COMMAND=claude
# CODEX_COMMAND=codex
# OCTOPUS_KANALOA_ADAPTER_EXECUTE=0
# OCTOPUS_KANALOA_WORKSPACE_ALLOWLIST=C:\safe\workspace

# --- API startup timing (Phase 4) ---
# OCTOPUS_STARTUP_LOG=1

# --- Runtime supervision / recovery (P2) ---
# OCTOPUS_RUNTIME_SUPERVISION_ENABLED=1
# OCTOPUS_STALLED_TASK_MINUTES=15
# OCTOPUS_CALLBACK_WAIT_MINUTES=10
# OCTOPUS_DEFAULT_MAX_RECOVERY_ATTEMPTS=2

# --- Kanaloa Orchestrator (P3) ---
# KANALOA_ORCHESTRATOR_MAX_SUBTASKS=8
# KANALOA_ORCHESTRATOR_MAX_ATTEMPTS=2
# KANALOA_ORCHESTRATOR_MAX_RUNTIME_SECONDS=3600
# KANALOA_ORCHESTRATOR_OBSERVE_POLL_SECONDS=0.35
# KANALOA_ORCHESTRATOR_OBSERVE_MAX_WAIT_SECONDS=120
